# .env 로 복사해서 본인 값으로 채우세요. (.env 는 커밋 금지)

# OpenAI (생성·RAGAS 판정: gpt-6-luna — 팀 통일, 임베딩: text-embedding-3-small)
OPENAI_API_KEY=

# PostgreSQL + pgvector (docker-compose.yml 기본값과 동일)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres

# 벡터 저장소: pgvector(교안 2장, Docker 필요) | memory(교안 1장, Docker 없이)
VECTOR_BACKEND=pgvector

# 생성 모델: 팀 통일 gpt-6-luna (기본값). gpt-6-luna 는 temperature 미지원 → none (기본값)
# LLM_MODEL=gpt-6-luna
# LLM_TEMPERATURE=none

# BM25 토큰화: whitespace(교안) | kiwi(비교 실험, uv add kiwipiepy 필요)
# BM25_TOKENIZER=whitespace
# 리랭커 장치: cpu(기본) | cuda | auto (GPU 사용은 직접 켤 때만)
# RERANKER_DEVICE=cpu
