# 복사해서 .env 로 사용하세요. (.env 는 절대 커밋하지 않습니다)

# --- 생성 모델 (LangChain init_chat_model 형식) ---
# provider: openai | anthropic | ...  (LangChain init_chat_model)
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- 임베딩 / reranker (로컬 HuggingFace 모델: 문서가 외부로 전송되지 않음) ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- 실행 설정 파일 ---
KANT_RAG_CONFIG=configs/default.yaml

# --- 국가법령정보센터 Open API (scripts/fetch_law.py) ---
LAW_OC=
