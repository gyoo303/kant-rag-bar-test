# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋하지 않음)

# OpenAI: 생성·리라이트·채점·임베딩
OPENAI_API_KEY=

# 로컬 Docker PostgreSQL 비밀번호 (compose.yaml 이 ${POSTGRES_PASSWORD} 로 읽음)
POSTGRES_PASSWORD=

# 개발·평가 DB 접속 문자열 (형식: postgresql://lawqa:<POSTGRES_PASSWORD>@localhost:5432/lawqa)
DATABASE_URL=

# 시험 DB 접속 문자열 (형식: postgresql://lawqa:<POSTGRES_PASSWORD>@localhost:5432/lawqa_test)
DATABASE_URL_TEST=

# (선택) reranker 모델 캐시 위치
HF_HOME=

# (선택) 로컬 DB 호스트 포트. 기본 5432. 다른 DB가 5432를 쓰면 바꾸고 위 두 URL의 포트도 맞춘다
POSTGRES_PORT=
